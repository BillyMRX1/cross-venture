# Firebase project (create at console.firebase.google.com, then copy here as .env)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA (Enterprise/v3) site key — mandatory for Firebase AI Logic
VITE_APPCHECK_SITE_KEY=

# Model names
VITE_CLOUD_MODEL=gemini-2.5-flash
VITE_ONDEVICE_MODEL=gemini-nano
