# Firebase project (create at console.firebase.google.com, then copy here as .env)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA Enterprise (Fraud Defense) site key — mandatory for Firebase AI Logic
VITE_APPCHECK_SITE_KEY=
# Local dev only: set to true to print an App Check debug token in the browser console (register it in Firebase console > App Check > Manage debug tokens). Never used in production builds.
VITE_APPCHECK_DEBUG=

# Model names
VITE_CLOUD_MODEL=gemini-3.8-flash
VITE_ONDEVICE_MODEL=gemini-nano
