rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ciphertext envelope only. Keys, token maps and plaintext are never stored.
    function validEnvelope(wsId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['wsId', 'ownerUid', 'iv', 'cipher', 'updatedAt'])
        && d.keys().hasAll(['wsId', 'ownerUid', 'iv', 'cipher', 'updatedAt'])
        && wsId.matches('^[A-Za-z0-9_-]{1,128}$')
        && d.wsId == wsId
        && d.ownerUid is string
        && d.iv is string && d.iv.size() > 0 && d.iv.size() <= 64
        && d.cipher is string && d.cipher.size() > 0 && d.cipher.size() <= 900000
        && d.updatedAt is number;
    }

    match /workspaces/{wsId} {
      // Deliberate read capability: any authenticated user who knows the id may GET the ciphertext
      // (phone pairing uses a different anonymous uid). Not identity-scoped. No listing.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && validEnvelope(wsId)
        && request.resource.data.ownerUid == request.auth.uid;

      // Legacy docs without ownerUid never match (null != uid) => cannot be claimed or mutated.
      allow update: if request.auth != null
        && resource.data.get('ownerUid', null) == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validEnvelope(wsId);

      allow delete: if request.auth != null
        && resource.data.get('ownerUid', null) == request.auth.uid;
    }
  }
}
